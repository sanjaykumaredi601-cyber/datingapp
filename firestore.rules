rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // SECURITY HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource.data.userId == request.auth.uid;
    }

    function isAdult(birthDate) {
      // 18 years in seconds = 18 * 365.25 * 24 * 60 * 60 = 568,024,000s
      return request.time >= birthDate + duration.value(568024000, 's');
    }

    function isParticipant(conversationData) {
      return isAuthenticated() && (
        request.auth.uid in conversationData.participantIds
      );
    }

    // ─────────────────────────────────────────────────────────
    // USERS COLLECTION
    // ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // Authenticated users can read profiles for nearby radar discovery and compatibility matching; only owner can write
      allow read: if isAuthenticated();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────
    // PROFILES COLLECTION
    // ─────────────────────────────────────────────────────────
    match /profiles/{userId} {
      // Public profiles: Authenticated users can view other profiles
      allow read: if isAuthenticated();

      // Profile creation & update: Strict validation
      allow create: if isOwner(userId)
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() >= 2
                    && request.resource.data.photos is list
                    && request.resource.data.photos.size() >= 2
                    && request.resource.data.photos.size() <= 6;

      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt']))
                    && request.resource.data.photos.size() >= 2
                    && request.resource.data.photos.size() <= 6;

      allow delete: if isOwner(userId);
    }

    // ─────────────────────────────────────────────────────────
    // CONVERSATIONS COLLECTION
    // ─────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      // Only conversation participants can view conversation metadata
      allow read: if isParticipant(resource.data);

      allow create: if isAuthenticated()
                    && request.resource.data.participantIds is list
                    && request.resource.data.participantIds.size() == 2
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.handshakeStatus in ['pending', 'accepted', 'declined'];

      allow update: if isParticipant(resource.data)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantIds', 'createdAt']))
                    && request.resource.data.handshakeStatus in ['pending', 'accepted', 'declined'];

      allow delete: if isParticipant(resource.data);

      // ───────────────────────────────────────────────────────
      // MESSAGES SUBCOLLECTION
      // ───────────────────────────────────────────────────────
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);

        // Sending: senderId must match authenticated user
        allow create: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.sentAt is timestamp;

        // Editing / Unsend / Delete for me
        allow update: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
                      && (
                        // Sender unsending message for everyone
                        (resource.data.senderId == request.auth.uid && request.resource.data.isUnsent == true)
                        // Participant setting deleted for me
                        || (request.resource.data.deletedForUsers is list)
                      );

        // Instant Purge: Either participant can purge messages in their conversation
        allow delete: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
      }
    }

    // ─────────────────────────────────────────────────────────
    // TOP-LEVEL MESSAGES (DIRECT QUERIES)
    // ─────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read, delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated()
                    && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid
      );
    }

    // ─────────────────────────────────────────────────────────
    // SUBSCRIPTIONS & ENTITLEMENTS
    // ─────────────────────────────────────────────────────────
    match /subscriptions/{userId} {
      // User can read their own subscription tier
      allow read: if isOwner(userId);
      // Only server / Cloud Functions backend can grant and modify entitlements
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // SUPPORT TICKETS (ENTERPRISE HELP DESK)
    // ─────────────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      // Authenticated users can read their own tickets
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || request.auth.token.admin == true
      );
      // Authenticated users can create tickets with required enterprise metadata
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['ticketId', 'userId', 'category', 'priority', 'status', 'createdAt'])
                    && request.resource.data.status == 'OPEN';
      // Only staff/admin or owner can update status/notes
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || request.auth.token.admin == true
      );
    }

    // ─────────────────────────────────────────────────────────
    // VOUCHERS (INSTANT ICEBREAKERS & COFFEE GIFTS)
    // ─────────────────────────────────────────────────────────
    match /vouchers/{voucherId} {
      // Vouchers are readable only by the sender or the recipient
      allow read: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid
      );
      // Sender creates voucher with valid status
      allow create: if isAuthenticated()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.keys().hasAll(['voucherId', 'senderId', 'recipientId', 'type', 'amount', 'status'])
                    && request.resource.data.status == 'ACTIVE';
      // Recipient or sender can redeem or update status
      allow update: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid
      );
    }

    // ─────────────────────────────────────────────────────────
    // ECHOES (REAL-TIME 500M PATH CROSSINGS)
    // ─────────────────────────────────────────────────────────
    match /echoes/{echoId} {
      // Readable and manageable only by the two intersected participants
      allow read: if isAuthenticated() && (
        resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.user1Id == request.auth.uid || request.resource.data.user2Id == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid
      );
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

